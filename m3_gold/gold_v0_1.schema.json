{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m3_gold_v0_1",
  "title": "M3 Gold Evidence v0.1 Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "source_split",
    "question",
    "options",
    "gold_answer",
    "gold_answer_text",
    "answerable",
    "gold_core_evidence_sets",
    "partial_evidence",
    "question_difficulty",
    "question_type",
    "concept_group",
    "personalisation_eligibility",
    "eligibility_reason",
    "split",
    "corpus_version",
    "parser_version",
    "gold_annotation_version",
    "annotation_status",
    "review_record_id",
    "source"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "source_split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/option"
        },
        "B": {
          "$ref": "#/$defs/option"
        },
        "C": {
          "$ref": "#/$defs/option"
        },
        "D": {
          "$ref": "#/$defs/option"
        }
      }
    },
    "gold_answer": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "gold_answer_text": {
      "type": "string",
      "minLength": 1
    },
    "answerable": {
      "type": "boolean"
    },
    "gold_core_evidence_sets": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/evidence_span"
        }
      }
    },
    "partial_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_span"
      }
    },
    "question_difficulty": {
      "type": "string",
      "enum": [
        "easy",
        "medium",
        "hard",
        "pending"
      ]
    },
    "question_type": {
      "type": "string",
      "enum": [
        "definition",
        "causal",
        "comparison",
        "calculation",
        "application",
        "identification",
        "other",
        "pending"
      ]
    },
    "concept_group": {
      "type": "string",
      "minLength": 1
    },
    "personalisation_eligibility": {
      "type": "string",
      "enum": [
        "full",
        "endpoint_only",
        "none",
        "pending"
      ]
    },
    "eligibility_reason": {
      "type": "string"
    },
    "split": {
      "type": "string",
      "enum": [
        "proposed_dev",
        "proposed_test",
        "dev",
        "test",
        "holdout",
        "pending"
      ]
    },
    "corpus_version": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "gold_annotation_version": {
      "type": "string",
      "minLength": 1
    },
    "annotation_status": {
      "type": "string",
      "enum": [
        "draft",
        "m3_initial",
        "reviewed",
        "disputed",
        "unresolved"
      ]
    },
    "review_record_id": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "source_question_id",
        "support"
      ],
      "properties": {
        "dataset": {
          "type": "string"
        },
        "source_question_id": {
          "type": "string"
        },
        "support": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_field"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "source_field": {
          "type": "string"
        }
      }
    },
    "evidence_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "span_id",
        "block_id",
        "document_id",
        "chapter_id",
        "char_start",
        "char_end",
        "verbatim_text",
        "sufficiency",
        "annotation_note"
      ],
      "properties": {
        "span_id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "chapter_id": {
          "type": "string",
          "minLength": 1
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 0
        },
        "verbatim_text": {
          "type": "string"
        },
        "sufficiency": {
          "type": "string",
          "enum": [
            "core_sufficient",
            "joint_core",
            "alternative_sufficient",
            "partial"
          ]
        },
        "annotation_note": {
          "type": "string"
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
