# Copy this file to .env and fill values locally. Never commit real secrets.
CS30_ENV=development
CS30_LOG_LEVEL=INFO
CS30_LOG_DIR=logs
CS30_PORT=8501
CS30_HEADLESS=false
CS30_FIXTURE_MODE=true
CS30_RETRIEVAL_MODE=hybrid
CS30_INDEX_DIR=data/index
CS30_TOP_K=5
CS30_RRF_K=60
CS30_RRF_INPUT_TOP_K=20
CS30_BM25_MIN_SCORE=0.0
# Set to false to run ablation A2 without query-side stopword filtering.
CS30_BM25_STOPWORDS=true

# Set this only after calibration on the evaluation dataset.
# CS30_DENSE_MIN_SIMILARITY=0.5

LLM_PROVIDER=mock
LLM_MODEL=mock-json-generator
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=