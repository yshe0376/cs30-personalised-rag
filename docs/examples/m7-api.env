# Copy to .env.m7 in the repository root; never commit the filled local file.
# PR #202 fixes the gpt-oss-20b family, but not a hosting provider/deployment.
M7_PROVIDER=
M7_BASE_URL=
M7_MODEL=
M7_MODEL_VERSION=
M7_GENERATION_API_KEY=
# Smoke: auto may probe provider support. Dev/repeat: fix a smoke-verified mode.
M7_OUTPUT_FORMAT=
# Set after checking provider/model reasoning and output-token requirements.
M7_MAX_OUTPUT_TOKENS=0
M7_EXTRA_BODY={}
M7_CONCURRENCY=3
# Leave empty unless the provider supports seed.
M7_API_SEED=
# Cumulative HTTP attempt caps, including retries and resumed attempts.
# Zero disables the batch. These are request limits, not dollar limits.
M7_SMOKE_REQUEST_CAP=0
M7_DEV_REQUEST_CAP=0
M7_REPEAT_REQUEST_CAP=0
